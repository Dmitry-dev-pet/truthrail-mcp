# Dedicated, unprivileged *shadow* Alfred MCP adapter image.
# No OpenAI tunnel runtime key, GitHub token, OAuth session, VPS host socket,
# historical source database, private Mac mount or public ingress in this image.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/app \
    HOME=/tmp
WORKDIR /app
COPY requirements-shared.txt /app/
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r requirements-shared.txt \
 && groupadd --system --gid 10001 alfred \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --home-dir /tmp alfred
COPY shared_alfred_gateway/ /app/shared_alfred_gateway/
USER 10001:10001
EXPOSE 8766
HEALTHCHECK --interval=60s --timeout=4s --start-period=20s --retries=3 \
  CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',8766),timeout=2); s.close()" || exit 1
CMD ["python", "-m", "shared_alfred_gateway.server"]
